# --- Static export (GitHub Pages) -----------------------------------------
# Public site URL (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph and JSON-LD. Set per-deployment; safe to leave empty in dev.
NEXT_PUBLIC_SITE_URL=

# Base path when hosting under a subdirectory, e.g. /my-repo on GitHub
# Pages. LEAVE EMPTY for a custom domain or a user.github.io root repo.
# The deploy workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=

# Set to "true" only when producing a static export (bun run build:pages).
STATIC_EXPORT=

# The app needs NO other configuration: no API keys, no database, no
# server-side services. Everything runs in the browser.

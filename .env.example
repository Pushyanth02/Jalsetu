# --- Site URL ---------------------------------------------------------------
# Public site URL (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph and JSON-LD.
#
# Resolution order (see src/lib/site-config.ts):
#   1. NEXT_PUBLIC_SITE_URL (this file / your platform's env vars)
#   2. Vercel production domain  — auto-detected, no configuration needed
#   3. Vercel deployment URL     — auto-detected (preview deployments)
#   4. http://localhost:3000     — local development
#
# On Vercel you can leave this empty: the platform's production domain is
# picked up automatically. Set it explicitly only when you attach a custom
# domain that Vercel does not know about, or when self-hosting.
NEXT_PUBLIC_SITE_URL=

# Base path when hosting under a subdirectory, e.g. /my-repo on GitHub
# Pages. LEAVE EMPTY for a custom domain or a user.github.io root repo.
# The deploy workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=

# Set to "true" only when producing a static export (bun run build:pages).
STATIC_EXPORT=

# The app needs NO other configuration: no API keys, no database, no
# server-side services. Everything runs in the browser.

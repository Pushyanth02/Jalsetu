# Optional: enables the Google Maps primary engine (client-side key). When
# unset, the keyless MapLibre fallback basemap is used and labelled as such.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Canonical site origin used by metadata, canonical, OG, robots and sitemap.
# Set this to your custom domain in production (e.g. https://jalsetu.example.org)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
